# ---------------------------------------------------------------------------
# Copia questo file in `.env.local` e adatta i valori.
# Vite espone al browser SOLO le variabili con prefisso VITE_.
# ---------------------------------------------------------------------------

# URL base dell'istanza Directus (senza slash finale).
# Va messo in `.env.local`, che git ignora, oppure nella variable del repository
# su GitHub (Settings -> Secrets and variables -> Actions -> Variables) con
# l'indirizzo pubblico HTTPS: il codice che finisce online non lo contiene.
# Se non e' impostato, il ripiego e' http://localhost:8055 e il sito mostra la
# schermata di manutenzione.
VITE_DIRECTUS_URL=https://cms.esempio.it

# --- Form contatti --------------------------------------------------------
# Endpoint completo del form (Formcarry: https://formcarry.com/s/IL_TUO_ID).
# Va messo in `.env.local` e, per il sito pubblicato, nella variable del
# repository su GitHub con lo stesso nome. Se resta vuoto il form contatti non
# viene mostrato: meglio nessun form che un form che non invia niente.
# L'origine di questo indirizzo viene aggiunta da sola alla Content-Security-
# Policy (`connect-src`) da `vite.config.js`.
# In produzione deve essere HTTPS: la pagina pubblicata gira in HTTPS e il
# browser bloccherebbe una chiamata in chiaro.
VITE_CONTACT_ENDPOINT=

# --- Identita' del sito ---------------------------------------------------
# Nome mostrato nell'intestazione e nel pie' di pagina. Se lo lasci vuoto il
# codice usa il nome del profilo.
VITE_SITE_NAME=Gabriele Bassi

# --- Collezioni -----------------------------------------------------------
VITE_COLLECTION_PROFILO=profilo
VITE_COLLECTION_PROGETTI=progetti
VITE_COLLECTION_ESPERIENZE=esperienze
# Titoli e sottotitoli delle sezioni.
VITE_COLLECTION_SEZIONI=sezioni

# --- Campi richiesti ------------------------------------------------------
# Lasciandoli vuoti valgono gli elenchi predefiniti nel codice
# (`src/hooks/useContent.js`): solo i campi che la pagina mostra davvero, cosi'
# Directus non manda al browser niente di piu'.
#
# Perche' conta: senza elenco arriva **l'intera riga**, quindi il giorno che in
# Directus aggiungi un campo privato (un telefono, una nota interna, una bozza)
# quello esce comunque dal tuo server e si legge nella scheda Rete di ogni
# visitatore, anche se in pagina non compare.
#
# Scrivendo un elenco qui, il predefinito viene sostituito; `*` significa di
# nuovo tutti i campi (comodo per una prova, da non lasciare online).
# Per una relazione multipla il percorso va chiesto per esteso, per esempio:
#   VITE_PROFILO_FIELDS=*,contatti.*
#
# Se un campo elencato non esiste piu' in Directus il sito non si spegne:
# riprova senza elenco (vedi `src/lib/directus.js`).
VITE_PROFILO_FIELDS=
VITE_PROGETTI_FIELDS=
VITE_ESPERIENZE_FIELDS=
VITE_SEZIONI_FIELDS=

# Nota su VITE_PROGETTI_FIELDS: la galleria di un progetto vive in una
# relazione multipla, e per averla va chiesta come `immagini.directus_files_id.*`.
# Il sito la aggiunge da solo all'elenco che scrivi qui; se invece elenchi i
# campi a mano e ci metti gia' `immagini`, il suo valore viene rispettato.

# --- Comportamento --------------------------------------------------------
# Timeout (ms) per le richieste verso Directus.
VITE_DIRECTUS_TIMEOUT=8000

# Se "true", quando il CMS non e' raggiungibile la pagina diventa la schermata
# di manutenzione, che riprova da sola ogni 30 secondi.
# Imposta "false" in sviluppo per vedere invece l'errore tecnico con la
# diagnostica delle sonde (indirizzo, stato del server, permessi).
# In nessuno dei due casi vengono mostrati contenuti inventati.
VITE_ENABLE_FALLBACK=true
